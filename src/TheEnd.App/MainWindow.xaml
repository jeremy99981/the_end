<Window x:Class="TheEnd.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Récap Brun — Transmission de fin de journée" Width="1000" Height="820" MinWidth="760" MinHeight="650" Background="{StaticResource Canvas}" WindowStartupLocation="CenterScreen">
  <Grid Margin="36,30">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0"><TextBlock Text="RÉCAP BRUN" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Ink}"/><TextBlock Text="Transmission de fin de journée" FontSize="18" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,26,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Date :" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/><TextBlock x:Name="DateText" Grid.Column="1" Margin="10,0,0,0" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="Équipier :" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="TeammateTextBox" Grid.Column="4" Height="44" Width="210" Padding="10,8" AcceptsReturn="False" TextChanged="InputChanged" ToolTip="Facultatif"/></Grid>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="10" Padding="22"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Ce qu’il reste à faire pour demain" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,0,14"/><TextBlock DockPanel.Dock="Bottom" Text="Une tâche par ligne, si besoin." Foreground="{StaticResource Muted}" Margin="0,12,0,0"/><TextBox x:Name="RemainingTextBox" TextChanged="InputChanged"/></DockPanel></Border>
      <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="10" Padding="22"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Objectifs de demain" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,0,14"/><TextBlock DockPanel.Dock="Bottom" Text="Les priorités à transmettre à l’équipe." Foreground="{StaticResource Muted}" Margin="0,12,0,0"/><TextBox x:Name="GoalsTextBox" TextChanged="InputChanged"/></DockPanel></Border>
    </Grid>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0"><Button Content="Effacer" Click="ClearClick" MinWidth="110"/><Button Content="Imprimer" Click="PrintClick" MinWidth="140" Background="{StaticResource Accent}" Foreground="White"/></StackPanel>
  </Grid>
</Window>
